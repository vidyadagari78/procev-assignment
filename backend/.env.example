# Server Configuration
PORT=5000

# Gemini Live / 2.0 Multimodal API Key (Free tier from Google AI Studio)
# https://aistudio.google.com/
GEMINI_API_KEY=

# Open-Source Whisper API Key (Groq provides free Whisper Large v3 at 200wps)
# https://console.groq.com/
GROQ_API_KEY=

# Database Configuration (Defaults to embedded relational SQLite transcriptions.db)
# To use PostgreSQL, set DATABASE_URL=postgres://user:password@localhost:5432/transcriptions
DATABASE_URL=
